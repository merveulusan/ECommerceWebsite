<!-- search area start  -->
<div class="nk-search-area">
    <div class="container">
        <div class="row">
            <div class="col-xs-0 col-sm-0 col-md-3 col-lg-3">
            </div>
            <div class="col-xs-12 col-sm-12 col-md-9 col-lg-9">
                <div class="nk-search">
                    
                    <div class="search_input">
                        
                        <input type="text" lang="tr" id="search" name="search" placeholder="Ürün, Kategori ve Marka Ara" style="width:860px;" />
                        <br/>

                        <div id="dv" style="width:860px; height:auto;margin-top:23px;border-style:solid;background-color:white;
                          border:#ff6a00ff;position:absolute;z-index:10000;">
                         <ul id="sul"></ul>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- main menu area end  -->

<script>
 
    //arama alanı
    $("#search").keyup(function(){
        var id = $("#search").val();
        if(id != "" && id.length>2){
            
            $.ajax({
              //arama yapcak
              url: '/Home/gettingSearch/' + id,
              type: 'POST',
              ContentType: "application/json;charset=utf-8",
              success: function(result){
               
                  //resulttan dönen sonucu,gizli çerçeve içinde yazdıracağız.
                  $("#sul").remove();
                  $("#dv").append("<ul id='sul'>")
                  $("#sul").append(result)
                  $("#dv").append("</ul>")

              }
            })
        }
        else{
          $("#sul").remove(); //eski bulduğu kayıtları silsin.backspace ile geri geldi.
        }

    })

</script>